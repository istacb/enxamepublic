#!/bin/bash
# Enxame - Script de desinstalação
# Remove completamente o Enxame do sistema

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENXAME_ROOT="$(dirname "$SCRIPT_DIR")"

echo "=== Enxame - Desinstalação ==="
echo ""

# Verifica se está rodando como root ou com sudo
if [ "$EUID" -ne 0 ]; then 
    echo "Por favor, execute como root (use sudo)"
    exit 1
fi

echo "ATENÇÃO: Isso removerá COMPLETAMENTE o Enxame do sistema."
echo "Todos os dados, logs e configurações serão perdidos."
echo ""
read -p "Deseja continuar? (y/N): " confirm

if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
    echo "Desinstalação cancelada."
    exit 0
fi

echo ""
echo "Removendo Enxame..."

# Para serviços (se systemd estiver disponível)
if command -v systemctl &> /dev/null; then
    if [ -f "/etc/systemd/system/enxame.service" ]; then
        echo "Parando serviço Enxame..."
        systemctl stop enxame || true
        systemctl disable enxame || true
        rm -f /etc/systemd/system/enxame.service
        systemctl daemon-reload
        echo "Serviço Enxame removido."
    fi
fi

# Remove diretórios de dados
echo "Removendo dados em /var/lib/enxame..."
rm -rf /var/lib/enxame
echo "Dados removidos."

# Remove logs
echo "Removendo logs em /var/log/enxame..."
rm -rf /var/log/enxame
echo "Logs removidos."

# Remove configuração
echo "Removendo configuração em /etc/enxame..."
rm -rf /etc/enxame
echo "Configuração removida."

# Remove sockets e arquivos temporários
echo "Limpando arquivos temporários..."
rm -rf /tmp/enxame*
rm -f /run/enxame.sock

echo ""
echo "=== Desinstalação concluída ==="
echo ""
echo "O Enxame foi completamente removido do sistema."
echo "Os arquivos de código em $ENXAME_ROOT foram preservados."
echo "Para reinstalar, execute o script 'install' novamente."
echo ""
