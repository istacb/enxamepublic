#!/bin/bash
# =============================================================================
# ENXAME - Script de Atualização Multi-Plataforma
# Atualiza preservando dados, configurações e modelos
# Comunica-se com todos os nodes do Enxame
# =============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENXAME_ROOT="$(dirname "$SCRIPT_DIR")"

# Detecta sistema operacional
detect_os() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo "macos"
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        if [ -f "/etc/debian_version" ]; then
            echo "ubuntu"
        else
            echo "linux"
        fi
    elif [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "win32" ]]; then
        echo "windows"
    else
        echo "unknown"
    fi
}

OS_TYPE=$(detect_os)

echo "╔══════════════════════════════════════════════════════════╗"
echo "║         ENXAME - Atualização ($OS_TYPE)                       ║"
echo "╚══════════════════════════════════════════════════════════╝"
echo ""

# Configura caminhos baseados no OS
case $OS_TYPE in
    "ubuntu"|"linux")
        CONFIG_DIR="/etc/enxame"
        DATA_DIR="/var/lib/enxame"
        LOG_DIR="/var/log/enxame"
        ;;
    "macos")
        CONFIG_DIR="$HOME/Library/Preferences/Enxame"
        DATA_DIR="$HOME/Library/Application Support/Enxame"
        LOG_DIR="$HOME/Library/Logs/Enxame"
        ;;
    "windows")
        CONFIG_DIR="%APPDATA%\\Enxame\\Config"
        DATA_DIR="%APPDATA%\\Enxame"
        LOG_DIR="%LOCALAPPDATA%\\Enxame\\Logs"
        ;;
esac

# Verifica permissões
if [[ "$OS_TYPE" != "windows" ]] && [ "$EUID" -ne 0 ]; then 
    echo "Erro: Execute como root/administrador"
    exit 1
fi

echo ">>> PASSO 1/5: Comunicando com nodes do Enxame..."
echo ""

# Descobre nodes ativos localmente (portas oficiais: Juiz 7700,
# Bibliotecário 7701, Ollama 11434 - ver spec/pt-BR/diagrams/deployment.mmd).
# [Não verificado] Não há endpoint HTTP de shutdown gracioso no código
# (juiz/app.py e bibliotecario/app.py só tratam o evento de shutdown do
# próprio processo ASGI). Por isso o shutdown gracioso é feito pedindo ao
# gerenciador de serviço (systemd/launchctl) para parar o processo, o que
# dispara esse evento via SIGTERM — não por uma chamada HTTP.
discover_local_nodes() {
    local nodes_found=0

    echo "Procurando nodes ativos neste host..."

    if curl -s --max-time 2 http://localhost:7700/api/v1/health > /dev/null 2>&1; then
        echo "  ✓ Juiz respondendo em :7700"
        nodes_found=$((nodes_found + 1))
    fi

    if curl -s --max-time 2 http://localhost:7701/api/v1/health > /dev/null 2>&1; then
        echo "  ✓ Bibliotecário respondendo em :7701"
        nodes_found=$((nodes_found + 1))
    fi

    if curl -s --max-time 2 http://localhost:11434/api/tags > /dev/null 2>&1; then
        echo "  ✓ Ollama respondendo em :11434"
        nodes_found=$((nodes_found + 1))
    fi

    if [ $nodes_found -eq 0 ]; then
        echo "  ! Nenhum node ativo encontrado neste host (serviço pode estar parado)"
    else
        echo "  Total: $nodes_found node(s) encontrados neste host"
    fi
}

discover_local_nodes

echo ""
echo ">>> PASSO 2/5: Criando backup completo..."
echo ""

BACKUP_DIR="/tmp/enxame_backup_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$BACKUP_DIR"

# Backup de configurações
if [ -f "$CONFIG_DIR/.env" ]; then
    cp "$CONFIG_DIR/.env" "$BACKUP_DIR/" 2>/dev/null || true
    echo "  ✓ Configurações backupadas"
fi

# Backup de dados
if [ -d "$DATA_DIR/data" ]; then
    cp -r "$DATA_DIR/data" "$BACKUP_DIR/" 2>/dev/null || true
    echo "  ✓ Dados backupados"
fi

# Backup de modelos (se existir)
if [ -d "$DATA_DIR/models" ]; then
    echo "  Backup de modelos detectado (preservando)..."
    mkdir -p "$BACKUP_DIR/models"
    # Apenas registra, não copia (modelos são grandes)
    ls -la "$DATA_DIR/models" > "$BACKUP_DIR/models_list.txt" 2>/dev/null || true
fi

# Backup de banco de dados
if [ -f "$DATA_DIR/enxame.db" ]; then
    cp "$DATA_DIR/enxame.db" "$BACKUP_DIR/" 2>/dev/null || true
    echo "  ✓ Banco de dados backupado"
fi

echo "  Backup criado em: $BACKUP_DIR"

echo ""
echo ">>> PASSO 3/5: Atualizando código e dependências..."
echo ""

cd "$ENXAME_ROOT"

# Atualiza código via git
if [ -d ".git" ]; then
    echo "Atualizando código do repositório..."
    git fetch --all
    git pull --rebase || echo "Aviso: Não foi possível atualizar do repositório"
    echo "  ✓ Código atualizado"
else
    echo "Repositório Git não encontrado."
fi

# Atualiza dependências Python. Usa o venv isolado criado pelo instalador
# (evita o erro "externally-managed-environment" do PEP 668 em Python
# 3.12+). Se não existir venv (instalação antiga, pré-correção), cria um
# agora e migra para esse modelo.
if [ ! -x "$ENXAME_ROOT/.venv/bin/pip" ]; then
    echo "Criando ambiente virtual Python em $ENXAME_ROOT/.venv..."
    python3 -m venv "$ENXAME_ROOT/.venv" 2>/dev/null || true
fi

if [ -x "$ENXAME_ROOT/.venv/bin/pip" ]; then
    VENV_PIP="$ENXAME_ROOT/.venv/bin/pip"
else
    # Fallback defensivo: sem venv disponível, tenta o pip do sistema.
    VENV_PIP="pip3"
fi

echo "Atualizando dependências Python..."
if [ -f "requirements.txt" ]; then
    "$VENV_PIP" install -r requirements.txt --quiet --upgrade 2>/dev/null || true
    echo "  ✓ Dependências Python atualizadas"
elif [ -d "kernel" ] && [ -f "kernel/requirements.txt" ]; then
    "$VENV_PIP" install -r kernel/requirements.txt --quiet --upgrade 2>/dev/null || true
    echo "  ✓ Dependências do Kernel atualizadas"
fi

# Atualiza dependências Node
if [ -f "package.json" ]; then
    echo "Atualizando dependências Node.js..."
    npm install --production --silent 2>/dev/null || true
    echo "  ✓ Dependências Node.js atualizadas"
fi

echo ""
echo ">>> PASSO 4/5: Restaurando dados e configurações..."
echo ""

# Restaura configurações
if [ -f "$BACKUP_DIR/.env" ]; then
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    cp "$BACKUP_DIR/.env" "$CONFIG_DIR/.env" 2>/dev/null || true
    echo "  ✓ Configurações restauradas"
fi

# Restaura dados
if [ -d "$BACKUP_DIR/data" ]; then
    mkdir -p "$DATA_DIR" 2>/dev/null || true
    cp -r "$BACKUP_DIR/data"/* "$DATA_DIR/" 2>/dev/null || true
    echo "  ✓ Dados restaurados"
fi

# Restaura banco de dados
if [ -f "$BACKUP_DIR/enxame.db" ]; then
    cp "$BACKUP_DIR/enxame.db" "$DATA_DIR/" 2>/dev/null || true
    echo "  ✓ Banco de dados restaurado"
fi

# Limpa backup
rm -rf "$BACKUP_DIR"

echo ""
echo ">>> PASSO 5/5: Reiniciando serviços..."
echo ""

case $OS_TYPE in
    "ubuntu"|"linux")
        if command -v systemctl &> /dev/null; then
            if [ -f "/etc/systemd/system/enxame.service" ]; then
                systemctl daemon-reload
                systemctl restart enxame || true
                echo "  ✓ Serviço systemd reiniciado"
            fi
        fi
        ;;
    "macos")
        LAUNCHAGENT="$HOME/Library/LaunchAgents/com.enxame.app.plist"
        if [ -f "$LAUNCHAGENT" ]; then
            launchctl unload "$LAUNCHAGENT" 2>/dev/null || true
            launchctl load "$LAUNCHAGENT" 2>/dev/null || true
            echo "  ✓ LaunchAgent reiniciado"
        fi
        ;;
    "windows")
        echo "  ! Reinicie o serviço manualmente ou use o atalho na Área de Trabalho"
        ;;
esac

# Aguarda serviços iniciarem
sleep 3

# Reanuncia este node na rede com a MESMA função salva anteriormente.
# Update nunca pergunta a função de novo — isso só acontece na primeira
# instalação.
if [[ "$OS_TYPE" != "windows" ]] && [ -f "$CONFIG_DIR/.env" ]; then
    echo ""
    echo "Reconfirmando função do node na rede..."
    ROLE_SETUP_PY="python3"
    [ -x "$ENXAME_ROOT/.venv/bin/python3" ] && ROLE_SETUP_PY="$ENXAME_ROOT/.venv/bin/python3"
    "$ROLE_SETUP_PY" "$ENXAME_ROOT/api/install/node_role_setup.py" --env-file "$CONFIG_DIR/.env" --non-interactive --scan-seconds 3 || true
fi

# Verifica saúde dos serviços
echo ""
echo "Verificando saúde dos serviços..."
if curl -s --max-time 5 http://localhost:7700/api/v1/health > /dev/null 2>&1; then
    echo "  ✓ Juiz online (:7700)"
else
    echo "  ! Juiz não respondeu em :7700 (pode estar inicializando, ou este node não é o Juiz)"
fi
if curl -s --max-time 5 http://localhost:7701/api/v1/health > /dev/null 2>&1; then
    echo "  ✓ Bibliotecário online (:7701)"
fi

echo ""
echo "╔══════════════════════════════════════════════════════════╗"
echo "║           ATUALIZAÇÃO CONCLUÍDA COM SUCESSO!             ║"
echo "╠══════════════════════════════════════════════════════════╣"
echo "║  • Código atualizado                                     ║"
echo "║  • Dependências atualizadas                              ║"
echo "║  • Dados preservados                                     ║"
echo "║  • Configurações preservadas                             ║"
echo "║  • Função do node preservada (sem nova pergunta)          ║"
echo "║                                                          ║"
echo "║  Função e porta deste node: ver $CONFIG_DIR/.env"
echo "╚══════════════════════════════════════════════════════════╝"
echo ""
