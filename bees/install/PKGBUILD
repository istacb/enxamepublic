# Maintainer: Enxame Project <contato@enxame.dev>
# Contributor: Community
pkgname=enxame-bee
pkgver=1.0.0
pkgrel=1
pkgdesc="ENXAME Bee - Abelha standalone offline-first com RAG local, descoberta mDNS e protocolo P2P"
arch=('x86_64' 'aarch64')
url="https://github.com/enxame/enxamepublic"
license=('MIT')
depends=(
    'python>=3.10'
    'python-pip'
    'python-httpx'
    'python-pydantic'
    'python-pydantic-settings'
    'python-psutil'
    'python-zeroconf'
    'python-cryptography'
    'python-rich'
    'python-pyaml'
    'curl'
    'ca-certificates'
    'sqlite'
)
optdepends=(
    'ollama: Runtime de modelos locais (recomendado)'
    'tesseract: OCR para documentos'
    'poppler: Leitura de PDFs'
    'nvidia-utils: Aceleracao GPU para modelos'
    'cuda: Suporte CUDA para inferencia'
)
makedepends=('git')
provides=('enxame-bee')
conflicts=('enxame-bee-git')
backup=('etc/enxame-bee/config.json')
install=enxame-bee.install
source=(
    "git+https://github.com/enxame/enxamepublic.git#tag=v${pkgver}"
    "enxame-bee.service"
    "enxame-bee.sysusers"
    "enxame-bee.tmpfiles"
    "config.json.example"
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
    cd "${srcdir}/enxamepublic"
    
    # Use the bees subdirectory
    if [[ ! -d "bees" ]]; then
        error "Diretorio bees nao encontrado no repositorio"
        return 1
    fi
}

build() {
    cd "${srcdir}/enxamepublic/bees"
    
    # Create virtual environment for building
    python -m venv --system-site-packages venv
    source venv/bin/activate
    
    # Install build dependencies
    pip install --upgrade pip setuptools wheel
    
    # Compile Python bytecode for faster startup
    python -m compileall -q .
    
    deactivate
}

package() {
    cd "${srcdir}/enxamepublic"
    
    # Install Python package to /opt
    install -dm755 "${pkgdir}/opt/enxame-bee"
    cp -r bees/* "${pkgdir}/opt/enxame-bee/"
    
    # Remove unnecessary files
    find "${pkgdir}/opt/enxame-bee" -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true
    find "${pkgdir}/opt/enxame-bee" -name '*.pyc' -delete 2>/dev/null || true
    find "${pkgdir}/opt/enxame-bee" -name '*.md' -delete 2>/dev/null || true
    rm -rf "${pkgdir}/opt/enxame-bee/tests" 2>/dev/null || true
    rm -rf "${pkgdir}/opt/enxame-bee/spec" 2>/dev/null || true
    rm -f "${pkgdir}/opt/enxame-bee/.gitignore" 2>/dev/null || true
    
    # Install bee wrapper script
    install -dm755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/bee" << 'EOF'
#!/bin/bash
# ENXAME Bee - CLI wrapper

export PYTHONPATH="/opt/enxame-bee:${PYTHONPATH:-}"
export BEE_HOME="${BEE_HOME:-$HOME/.enxame/bee}"

# Ensure data directory exists
mkdir -p "$BEE_HOME"
mkdir -p "$BEE_HOME/documents"
mkdir -p "$BEE_HOME/zim"
mkdir -p "$BEE_HOME/lancedb"
mkdir -p "$BEE_HOME/cache"
mkdir -p "$BEE_HOME/logs"

exec python -m bees.cli "$@"
EOF
    chmod +x "${pkgdir}/usr/bin/bee"
    
    # Install enxame-install-ollama helper
    cat > "${pkgdir}/usr/bin/enxame-install-ollama" << 'EOF'
#!/bin/bash
# ENXAME Bee - Ollama installer for Arch Linux

set -euo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

main() {
    echo -e "${BLUE}==================================================${NC}"
    echo -e "${BLUE}  ENXAME Bee - Ollama Installer (Arch Linux)${NC}"
    echo -e "${BLUE}==================================================${NC}"
    echo
    
    if command -v ollama &> /dev/null; then
        log "Ollama ja instalado: $(ollama --version)"
        return 0
    fi
    
    # Check if ollama is in official repos
    if pacman -Si ollama &>/dev/null; then
        log "Instalando Ollama via pacman..."
        sudo pacman -S --needed ollama
    else
        # Install from AUR or official script
        if command -v yay &>/dev/null; then
            log "Instalando Ollama via yay (AUR)..."
            yay -S --needed ollama
        elif command -v paru &>/dev/null; then
            log "Instalando Ollama via paru (AUR)..."
            paru -S --needed ollama
        else
            warn "Nenhum helper AUR encontrado. Usando script oficial..."
            curl -fsSL https://ollama.com/install.sh | sh
        fi
    fi
    
    # Enable and start service
    log "Habilitando e iniciando servico systemd..."
    sudo systemctl daemon-reload
    sudo systemctl enable ollama
    sudo systemctl start ollama
    
    # Wait for service
    sleep 3
    
    if ollama list &> /dev/null; then
        log "Ollama instalado e rodando!"
    else
        error "Falha ao iniciar Ollama"
        return 1
    fi
}

main "$@"
EOF
    chmod +x "${pkgdir}/usr/bin/enxame-install-ollama"
    
    # Install systemd service
    install -dm755 "${pkgdir}/usr/lib/systemd/system"
    install -m644 "${srcdir}/enxame-bee.service" "${pkgdir}/usr/lib/systemd/system/enxame-bee.service"
    
    # Install sysusers.d
    install -dm755 "${pkgdir}/usr/lib/sysusers.d"
    install -m644 "${srcdir}/enxame-bee.sysusers" "${pkgdir}/usr/lib/sysusers.d/enxame-bee.conf"
    
    # Install tmpfiles.d
    install -dm755 "${pkgdir}/usr/lib/tmpfiles.d"
    install -m644 "${srcdir}/enxame-bee.tmpfiles" "${pkgdir}/usr/lib/tmpfiles.d/enxame-bee.conf"
    
    # Install config example
    install -dm755 "${pkgdir}/etc/enxame-bee"
    install -m644 "${srcdir}/config.json.example" "${pkgdir}/etc/enxame-bee/config.json.example"
    
    # Install license
    install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
    cat > "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" << 'EOF'
MIT License

Copyright (c) 2024 Enxame Project

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.
EOF
}

