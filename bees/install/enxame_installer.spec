        'pdfplumber',
        'docx',
        'zimply',
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        'tkinter', 'matplotlib', 'pytest', 'jupyter', 'notebook',
        'IPython', 'sphinx', 'docutils', 'setuptools', 'wheel',
    ],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.zipfiles,
    a.datas,
    [],
    name='enxame_installer',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
