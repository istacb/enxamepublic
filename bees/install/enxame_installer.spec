block_cipher = None

a = Analysis(
    ['universal_installer.py'],
    pathex=[],
    binaries=[],
    datas=[
        ('../bees', 'bees'),
        ('../core', 'core'),
        ('../bibliotecario', 'bibliotecario'),
    ],
    hiddenimports=[
        'bees',
        'bees.config',
        'bees.service',
        'bees.librarian',
        'bees.memory',
        'bees.discovery',
        'bees.protocol',
        'bees.protocol.messages',
        'bees.protocol.handler',
        'bees.protocol.envelope',
        'bees.capabilities',
        'bees.capabilities.provider',
        'bees.capabilities.selector',
        'bees.capabilities.discovery',
        'core.ollama.client',
        'core.discovery.mdns_discovery',
        'core.exp.security',
        'core.exp.secure_logger',
        'bibliotecario.embeddings',
        'bibliotecario.indexer',
